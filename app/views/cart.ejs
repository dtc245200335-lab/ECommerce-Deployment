
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">
    <title>Giỏ hàng - E-Commerce</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f3f5f9;
            color: #172033;
        }

        header {
            background: #172c56;
            color: white;
            padding: 24px 8%;
        }

        main {
            max-width: 950px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .cart {
            background: white;
            padding: 24px;
            border-radius: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 14px 8px;
            border-bottom: 1px solid #eee;
            text-align: left;
        }

        .total {
            text-align: right;
            font-size: 22px;
            font-weight: bold;
            margin-top: 25px;
        }

        a {
            color: #2563eb;
            text-decoration: none;
        }

        .back {
            display: inline-block;
            margin-top: 20px;
        }
        .checkout-button {
    display: inline-block;
    padding: 12px 20px;
    background: #172c56;
    color: white;
    border-radius: 8px;
    font-weight: bold;
    margin-top: 15px;
}

.checkout-button:hover {
    background: #284578;
}
    </style>
</head>

<body>
    <header>
        <h1>Giỏ hàng của bạn</h1>
        <p>E-Commerce Store - Đề tài 09</p>
    </header>

    <main>
        <section class="cart">
            <% if (items.length === 0) { %>
                <p>Giỏ hàng đang trống.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Thao tác</th>
                            
                        </tr>
                        
                    </thead>

                    
<tbody>
    <% items.forEach(item => { %>
        <tr>
            <!-- Tên sản phẩm -->
            <td><%= item.name %></td>

            <!-- Đơn giá -->
            <td>
                <%= Number(item.price).toLocaleString('vi-VN') %> ₫
            </td>

            <!-- Cập nhật số lượng -->
            <td>
                <form action="/cart/update" method="POST">
                    <input
                        type="hidden"
                        name="productId"
                        value="<%= item.id %>"
                    >

                    <input
                        type="number"
                        name="quantity"
                        value="<%= item.quantity %>"
                        min="1"
                        max="<%= item.stock %>"
                        style="width:65px; padding:5px;"
                        required
                    >

                    <button type="submit">Cập nhật</button>
                </form>
            </td>

            <!-- Thành tiền -->
            <td>
                <%= item.subtotal.toLocaleString('vi-VN') %> ₫
            </td>

            <!-- Xóa sản phẩm -->
            <td>
                <form action="/cart/remove" method="POST">
                    <input
                        type="hidden"
                        name="productId"
                        value="<%= item.id %>"
                    >
                    <button type="submit">Xóa</button>
                </form>
            </td>
        </tr>
    <% }) %>
</tbody>

                </table>

                <p class="total">
                    Tổng tiền:
                    <%= total.toLocaleString('vi-VN') %> ₫
                </p>
                <a href="/checkout" class="checkout-button">
                    Tiến hành đặt hàng
                </a>
            <% } %>

            <a class="back" href="/">← Tiếp tục mua hàng</a>
        </section>
    </main>
</body>
</html>
